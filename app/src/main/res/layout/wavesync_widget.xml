<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="#151D2B">
    <TextView android:id="@+id/widget_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="WaveSync" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="17sp"/>
    <TextView android:id="@+id/widget_subtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Quick audio controls" android:textColor="#8E9AAF" android:textSize="11sp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginTop="8dp">
        <TextView android:id="@+id/widget_previous" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:gravity="center" android:text="|◀" android:textColor="#62E6D4" android:textSize="20sp"/>
        <TextView android:id="@+id/widget_play" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:gravity="center" android:text="▶ / ❚❚" android:textColor="#62E6D4" android:textSize="18sp"/>
        <TextView android:id="@+id/widget_next" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:gravity="center" android:text="▶|" android:textColor="#62E6D4" android:textSize="20sp"/>
    </LinearLayout>
    <TextView android:id="@+id/widget_open" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="OPEN WAVESYNC" android:textColor="#9B8CFF" android:textStyle="bold" android:textSize="10sp" android:paddingTop="4dp"/>
</LinearLayout>
